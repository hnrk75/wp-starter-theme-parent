{
  "name": "hnrk75/wp-starter-theme-parent",
  "description": "WP Starter Theme — parent theme for client sites. Customize in a child theme.",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/hnrk75/wp-starter-theme-parent",
  "authors": [
    {
      "name": "Henrik Pettersson",
      "homepage": "https://github.com/hnrk75"
    }
  ],
  "support": {
    "issues": "https://github.com/hnrk75/wp-starter-theme-parent/issues"
  },
  "require": {
    "php": ">=8.4",
    "composer/installers": "^2.3"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.2",
    "squizlabs/php_codesniffer": "^3.10",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-cli/i18n-command": "^2.6",
    "wp-cli/wp-cli": "^2.11",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.5.12"
    }
  },
  "scripts": {
    "lint": "phpcs -p -s -d memory_limit=512M --standard=phpcs.xml",
    "lint:fix": "phpcbf -p -d memory_limit=512M --standard=phpcs.xml",
    "analyze": "phpstan analyse -c phpstan.neon --memory-limit=1G",
    "test": [
      "@lint",
      "@analyze"
    ],
    "i18n": [
      "wp i18n make-pot . languages/wp-starter-theme.pot --domain=wp-starter-theme --exclude=node_modules,vendor,assets",
      "wp i18n update-po languages/wp-starter-theme.pot languages/sv_SE.po"
    ],
    "i18n:mo": "wp i18n make-mo languages/sv_SE.po languages/"
  },
  "extra": {
    "installer-name": "wp-starter-theme"
  }
}
