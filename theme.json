{
  "version": 3,
  "settings": {
    "useRootPaddingAwareAlignments": true,
    "appearanceTools": true,
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "defaultFontFamilies": false,
      "customFontSize": false,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Body (Montserrat)",
          "fontFamily": "Montserrat, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Montserrat",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/montserrat-latin-wght-normal.woff2" ]
            }
          ]
        },
        {
          "slug": "heading",
          "name": "Heading (Fraunces)",
          "fontFamily": "Fraunces, serif",
          "fontFace": [
            {
              "fontFamily": "Fraunces",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/fraunces-latin-opsz-normal.woff2" ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "display-1",
          "name": "Display",
          "size": "4rem",
          "fluid": { "min": "2.75rem", "max": "4rem" }
        },
        {
          "slug": "h-1",
          "name": "H1",
          "size": "2.75rem",
          "fluid": { "min": "2rem", "max": "2.75rem" }
        },
        {
          "slug": "h-2",
          "name": "H2",
          "size": "2.25rem",
          "fluid": { "min": "1.5rem", "max": "2.25rem" }
        },
        {
          "slug": "h-3",
          "name": "H3",
          "size": "1.625rem",
          "fluid": { "min": "1.25rem", "max": "1.625rem" }
        },
        {
          "slug": "h-4",
          "name": "H4",
          "size": "1.375rem",
          "fluid": { "min": "1.125rem", "max": "1.375rem" }
        },
        {
          "slug": "h-5",
          "name": "H5",
          "size": "1.125rem"
        },
        {
          "slug": "h-6",
          "name": "H6",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Large (ingress)",
          "size": "1.25rem",
          "fluid": { "min": "1.125rem", "max": "1.25rem" }
        },
        {
          "slug": "medium",
          "name": "Medium (body)",
          "size": "1rem",
          "fluid": { "min": "1rem", "max": "1rem" }
        },
        {
          "slug": "small",
          "name": "Small (caption)",
          "size": "0.875rem",
          "fluid": { "min": "0.75rem", "max": "0.875rem" }
        }
      ]
    },
    "layout": {
      "contentSize": "82.5rem",
      "wideSize": "100rem"
    },
    "custom": {
      "radius": { "sm": "0.25rem", "base": "0.375rem", "md": "0.5rem", "lg": "1rem", "pill": "50rem" },
      "transition": { "base": "0.3s ease" },
      "fontWeight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
      "lineHeight": { "body": "1.6", "heading": "1.2" },
      "color": {
        "background": "var(--wp--preset--color--white)",
        "text": "var(--wp--preset--color--gray-900)",
        "heading": "currentcolor"
      },
      "link": { "hoverColor": "color-mix(in srgb, var(--wp--preset--color--primary), #000 25%)" },
      "measure": "42rem",
      "lead": { "width": "45rem", "lineHeight": "1.55" },
      "display": { "lineHeight": "1.1", "letterSpacing": "0" },
      "heading": {
        "textTransform": "none",
        "h1": { "fontWeight": "var(--wp--custom--font-weight--bold)", "lineHeight": "1.1", "letterSpacing": "0" },
        "h2": { "fontWeight": "var(--wp--custom--font-weight--bold)", "lineHeight": "1.15", "letterSpacing": "0" },
        "h3": { "fontWeight": "var(--wp--custom--font-weight--semibold)", "lineHeight": "1.2", "letterSpacing": "0" },
        "h4": { "fontWeight": "var(--wp--custom--font-weight--semibold)", "lineHeight": "1.25", "letterSpacing": "0.01em" },
        "h5": { "fontWeight": "var(--wp--custom--font-weight--semibold)", "lineHeight": "1.3", "letterSpacing": "0.02em" },
        "h6": { "fontWeight": "var(--wp--custom--font-weight--semibold)", "lineHeight": "1.35", "letterSpacing": "0.03em" }
      },
      "focus": { "width": "0.125rem", "offset": "0.1875rem" },
      "button": {
        "radius": "var(--wp--custom--radius--pill)",
        "primaryHoverBackground": "color-mix(in srgb, var(--wp--preset--color--primary), #000 15%)",
        "successHoverBackground": "color-mix(in srgb, var(--wp--preset--color--success), #000 15%)",
        "dangerHoverBackground": "color-mix(in srgb, var(--wp--preset--color--error), #000 15%)",
        "padding": "0.5rem 1.5rem",
        "gap": "0.5rem",
        "sm": { "padding": "0.375rem 1rem", "fontSize": "0.875rem" },
        "lg": { "padding": "0.75rem 2rem", "fontSize": "1.125rem" }
      },
      "nav": {
        "itemPadding": "0.5rem 0.75rem",
        "hoverBackground": "rgb(0 0 0 / 0.05)",
        "submenuWidth": "12rem",
        "submenuShadow": "0 4px 12px rgb(0 0 0 / 0.1)",
        "overlay": "rgb(0 0 0 / 0.4)"
      },
      "logo": { "height": "clamp(2rem, 4vw, 3rem)", "color": "var(--wp--preset--color--gray-900)" },
      "footer": { "fontSize": "0.875rem" }
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "sm", "name": "SM", "shadow": "0 0.0625rem 0.1875rem rgb(0 0 0 / 0.08), 0 0.0625rem 0.125rem rgb(0 0 0 / 0.06)" },
        { "slug": "md", "name": "MD", "shadow": "0 0.25rem 0.75rem rgb(0 0 0 / 0.1), 0 0.125rem 0.25rem rgb(0 0 0 / 0.06)" },
        { "slug": "lg", "name": "LG", "shadow": "0 0.625rem 1.875rem rgb(0 0 0 / 0.12), 0 0.25rem 0.5rem rgb(0 0 0 / 0.08)" },
        { "slug": "xl", "name": "XL", "shadow": "0 1.25rem 3.75rem rgb(0 0 0 / 0.16), 0 0.5rem 1rem rgb(0 0 0 / 0.08)" }
      ]
    },
    "spacing": {
      "customSpacing": false,
      "spacingScale": {
        "operator": "linear",
        "increment": 1,
        "steps": 0
      },
      "spacingSizes": [
        { "slug": "xs", "name": "XS", "size": "clamp(0.375rem, 0.5vw, 0.625rem)" },
        { "slug": "sm", "name": "SM", "size": "clamp(0.625rem, 1vw, 1.25rem)" },
        { "slug": "md", "name": "MD", "size": "clamp(1.25rem, 2vw, 2.5rem)" },
        { "slug": "lg", "name": "LG", "size": "clamp(2.5rem, 4vw, 5rem)" },
        { "slug": "xl", "name": "XL", "size": "clamp(5rem, 8vw, 10rem)" }
      ]
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "customGradient": false,
      "disableCustomColors": true,
      "palette": [
        { "slug": "primary",        "color": "#2563eb", "name": "Primary" },
        { "slug": "white",          "color": "#ffffff", "name": "White" },
        { "slug": "gray-50",        "color": "#f9fafb", "name": "Gray 50" },
        { "slug": "gray-100",       "color": "#f3f4f6", "name": "Gray 100" },
        { "slug": "gray-200",       "color": "#e5e7eb", "name": "Gray 200" },
        { "slug": "gray-300",       "color": "#d1d5db", "name": "Gray 300" },
        { "slug": "gray-400",       "color": "#9ca3af", "name": "Gray 400" },
        { "slug": "gray-500",       "color": "#6b7280", "name": "Gray 500" },
        { "slug": "gray-600",       "color": "#4b5563", "name": "Gray 600" },
        { "slug": "gray-700",       "color": "#374151", "name": "Gray 700" },
        { "slug": "gray-800",       "color": "#1f2937", "name": "Gray 800" },
        { "slug": "gray-900",       "color": "#111827", "name": "Gray 900" },
        { "slug": "black",          "color": "#030712", "name": "Black" },
        { "slug": "success",        "color": "#16a34a", "name": "Success" },
        { "slug": "success-subtle", "color": "#dcfce7", "name": "Success Subtle" },
        { "slug": "warning",        "color": "#d97706", "name": "Warning" },
        { "slug": "warning-subtle", "color": "#fef3c7", "name": "Warning Subtle" },
        { "slug": "error",          "color": "#dc2626", "name": "Error" },
        { "slug": "error-subtle",   "color": "#fee2e2", "name": "Error Subtle" },
        { "slug": "info",           "color": "#0284c7", "name": "Info" },
        { "slug": "info-subtle",    "color": "#e0f2fe", "name": "Info Subtle" }
      ]
    }
  }
}
