# Files left out of the package Composer downloads (GitHub's zip of a tag).
# They are only needed to develop the theme, not to run it.
/.gitattributes       export-ignore
/.github              export-ignore
/.gitignore           export-ignore
/.npmrc               export-ignore
/.nvmrc               export-ignore
/.prettierrc.json     export-ignore
/composer.lock        export-ignore
/phpcs.xml            export-ignore
/phpstan.neon         export-ignore
/phpstan-bootstrap.php export-ignore
/.stylelintrc.json    export-ignore
/eslint.config.mjs    export-ignore
/gulpfile.mjs         export-ignore
/package.json         export-ignore
/package-lock.json    export-ignore
/scripts              export-ignore
